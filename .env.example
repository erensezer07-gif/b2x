# B2X — ortam değişkenleri şablonu
#
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# .env dosyası git'e girmez, asla commit edilmez.
#
# Windows PowerShell:  Copy-Item .env.example .env

# --- Docker Compose ---
# Konteyner ve ağ adlarının öneki. Aynı makinede ikinci bir kopya çalışacaksa değiştir.
COMPOSE_PROJECT_NAME=b2x

# --- Uygulama ---
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Tarayıcıdan (Flutter web) API'ye izin verilen kaynaklar. Virgülle ayrılır.
# Geliştirmede Flutter web her çalıştırmada farklı port kullanır, bu yüzden *.
# Sunucuya kurulumda gerçek adres yazılır: https://ornek.com,https://www.ornek.com
CORS_ORIGINS=*

# --- Veritabanı ---
# Aşağıdaki host değeri, backend Windows'ta native çalışırken geçerlidir.
# Compose içindeki api ve worker servisleri bunu kendileri "db" olarak geçersiz kılar.
POSTGRES_USER=b2x
POSTGRES_PASSWORD=degistir_bunu
POSTGRES_DB=b2x
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
# Compose içinde "redis" olarak geçersiz kılınır.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kimlik ---
# Rastgele uzun bir dize üret, örnek: openssl rand -hex 32
JWT_SECRET=degistir_bunu_rastgele_uzun_bir_dize
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30

# --- Dosya depolama ---
# MVP'de yerel klasör. Devirde bulut depolamaya geçilecekse burası değişir.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files

# --- Eşleştirme motoru varsayılanları ---
# Bu değerler etkinlik bazında da ayarlanabilir, buradakiler varsayılan.
MATCHING_MIN_MEETINGS_PER_PERSON=4
MATCHING_QUALITY_THRESHOLD=0.35
MATCHING_DEFAULT_SEED=42
MATCHING_MAX_ITERATIONS=100000
MATCHING_MOVE_PENALTY=5.0

# --- Talep sistemi ---
REQUEST_QUOTA_PER_PARTICIPANT=3

# --- İstemci ---
# Flutter derlemesine dışarıdan verilir, koda gömülmez.
# Telefondan test için bilgisayarın yerel ağ adresi yazılır: http://192.168.x.x:8000
API_BASE_URL=http://localhost:8000
